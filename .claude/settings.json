{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run db:build)",
      "Bash(npm run migration:*)",
      "Bash(npx ng build:*)",
      "Bash(npx ng g fuse-schematics:*)",
      "Bash(npx -y npm@11 install:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose up -d)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(./legacy/**)",
      "Write(./legacy/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf .git:*)",
      "Bash(docker compose down -v:*)"
    ]
  }
}
