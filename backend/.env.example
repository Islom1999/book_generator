NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
CLIENT_URL=http://localhost:4200

# PostgreSQL (docker compose: localhost:55433)
DB_HOST=localhost
DB_PORT=55433
DB_USER=ertaklar
DB_PASSWORD=ertaklar
DB_NAME=ertaklar_app
DB_LOGGING=false

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth. JWT_SECRET must be 32+ random characters in production.
JWT_SECRET=change-me-change-me-change-me-change-me
ADMIN_JWT_EXPIRES_IN=12h
USER_JWT_EXPIRES_IN=30d
# First super admin, created only when admin_users is empty.
ADMIN_EMAIL=admin@ertaklar.uz
ADMIN_PASSWORD=admin12345

# Customer login
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=

# AI providers (phase 1)
OPENROUTER_API_KEY=
REPLICATE_API_TOKEN=
