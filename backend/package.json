{
  "name": "ertaklar-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build api && nest build worker && nest build bot",
    "start:api": "nest start api --watch",
    "start:worker": "nest start worker --watch",
    "start:bot": "nest start bot --watch",
    "start:prod:api": "node dist/apps/api/main.js",
    "start:prod:worker": "node dist/apps/worker/main.js",
    "start:prod:bot": "node dist/apps/bot/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint apps/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:build": "rm -rf dist/db && tsc -p libs/database/tsconfig.cli.json",
    "migration:generate": "npm run db:build && node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/db/database/src/data-source.js migration:generate libs/database/src/migrations/$npm_config_name",
    "migration:create": "typeorm migration:create libs/database/src/migrations/$npm_config_name",
    "migration:run": "npm run db:build && node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/db/database/src/data-source.js migration:run",
    "migration:revert": "npm run db:build && node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/db/database/src/data-source.js migration:revert"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "^11.2.0",
    "grammy": "^1.46.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  }
}
